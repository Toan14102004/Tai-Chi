    "Watch a short ad to download this workout, or enjoy unlimited downloads and a completely ad-free experience." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد إعلانًا قصيرًا لتنزيل هذا التمرين، أو استمتع بتنزيلات غير محدودة وتجربة خالية تمامًا من الإعلانات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ওয়ার্কআউটটি ডাউনলোড করতে একটি ছোট বিজ্ঞাপন দেখুন বা সীমাহীন ডাউনলোড এবং সম্পূর্ণ বিজ্ঞাপন-মুক্ত অভিজ্ঞতা উপভোগ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehen Sie sich eine kurze Anzeige an, um dieses Training herunterzuladen, oder genießen Sie unbegrenzte Downloads und ein völlig werbefreies Erlebnis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira un anuncio corto para descargar este entrenamiento, o disfruta de descargas ilimitadas y una experiencia sin anuncios."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای دانلود این تمرین یک تبلیغ کوتاه تماشا کنید یا از دانلودهای نامحدود و تجربه ای کاملاً بدون آگهی لذت ببرید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez une courte publicité pour télécharger cette séance, ou profitez de téléchargements illimités et d'une expérience entièrement sans publicité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह वर्कआउट डाउनलोड करने के लिए एक छोटा विज्ञापन देखें, या अनलिमिटेड डाउनलोड और पूरी तरह विज्ञापन-मुक्त अनुभव पाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonton iklan singkat untuk mengunduh latihan ini, atau nikmati unduhan tanpa batas dan pengalaman bebas iklan sepenuhnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短い広告を見てこのワークアウトをダウンロードするか、無制限のダウンロードと広告なしの体験をお楽しみください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짧은 광고를 보고 이 운동을 다운로드하거나, 무제한 다운로드와 광고 없는 환경을 누려보세요."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਕਸਰਤ ਨੂੰ ਡਾਊਨਲੋਡ ਕਰਨ ਲਈ ਇੱਕ ਛੋਟਾ ਵਿਗਿਆਪਨ ਦੇਖੋ, ਜਾਂ ਅਸੀਮਤ ਡਾਉਨਲੋਡਸ ਅਤੇ ਪੂਰੀ ਤਰ੍ਹਾਂ ਵਿਗਿਆਪਨ-ਮੁਕਤ ਅਨੁਭਵ ਦਾ ਆਨੰਦ ਲਓ।"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assista a um pequeno anúncio para baixar este treino ou desfrute de downloads ilimitados e de uma experiência totalmente livre de anúncios."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посмотрите короткую рекламу, чтобы скачать эту тренировку, или получите безлимитные загрузки и полностью без рекламы."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tazama tangazo fupi ili kupakua mazoezi haya, au ufurahie upakuaji bila kikomo na matumizi bila matangazo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "观看一段短广告即可下载此训练，或升级享受无限下载与完全无广告的体验。"
          }
        }
      }
    },
