    "It'll help us personalize your plan to better suit your age group." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيساعدنا ذلك في تخصيص خطتك لتناسب فئتك العمرية بشكل أفضل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি আমাদেরকে আপনার বয়সের সাথে আরও ভালভাবে উপযুক্ত করার জন্য আপনার পরিকল্পনাকে ব্যক্তিগতকৃত করতে সাহায্য করবে৷"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies hilft uns, Ihren Plan so zu personalisieren, dass er besser zu Ihrer Altersgruppe passt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos ayudará a personalizar tu plan según tu grupo de edad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این به ما کمک می‌کند تا برنامه شما را برای گروه سنی شما شخصی‌سازی کنیم."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela nous aidera à personnaliser votre programme selon votre tranche d'âge."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे हमें आपकी उम्र के अनुसार योजना को बेहतर बनाने में मदद मिलेगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan membantu kami mempersonalisasi rencana Anda agar lebih sesuai dengan kelompok usia Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年齢層に合わせてプランをより良くパーソナライズするのに役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연령대에 더 잘 맞는 플랜을 만드는 데 도움이 됩니다."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ ਤੁਹਾਡੀ ਉਮਰ ਸਮੂਹ ਨੂੰ ਬਿਹਤਰ ਢੰਗ ਨਾਲ ਅਨੁਕੂਲ ਬਣਾਉਣ ਲਈ ਤੁਹਾਡੀ ਯੋਜਨਾ ਨੂੰ ਵਿਅਕਤੀਗਤ ਬਣਾਉਣ ਵਿੱਚ ਸਾਡੀ ਮਦਦ ਕਰੇਗਾ।"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso nos ajudará a personalizar seu plano para melhor atender sua faixa etária."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это поможет нам адаптировать ваш план под вашу возрастную группу."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itatusaidia kubinafsisha mpango wako ili kuendana vyema na rika lako."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将帮助我们根据您的年龄段为您定制计划。"
          }
        }
      }
    },
