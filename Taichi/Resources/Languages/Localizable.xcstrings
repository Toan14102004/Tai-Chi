    "Độ rộng phần nhô (bumpWidth): %lld" : {
      "comment" : "A label describing a slider that adjusts the width of a shape's \"bump\" section. The text inside the parentheses is a placeholder for what the slider adjusts",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
