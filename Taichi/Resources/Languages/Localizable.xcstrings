    "Want to keep going, take a short break, or continue later?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد الاستمرار، أو أخذ استراحة قصيرة، أو الاستمرار لاحقًا؟"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "চালিয়ে যেতে চান, একটি ছোট বিরতি নিতে চান বা পরে চালিয়ে যেতে চান?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie weitermachen, eine kurze Pause einlegen oder später weitermachen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres seguir, tomarte un descanso o continuar más tarde?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "می خواهید ادامه دهید، استراحت کوتاهی داشته باشید یا بعدا ادامه دهید؟"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous voulez continuer, faire une courte pause ou reprendre plus tard ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जारी रखना चाहेंगे, थोड़ा आराम करेंगे या बाद में जारी रखेंगे?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingin melanjutkan, istirahat sejenak, atau melanjutkannya nanti?"
