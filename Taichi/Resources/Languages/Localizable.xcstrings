    "You've completed all your workouts today. Your body is getting stronger keep it up!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد أكملت جميع التدريبات الخاصة بك اليوم. جسمك يزداد قوة، استمر في ذلك!"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি আজ আপনার সমস্ত ওয়ার্কআউট সম্পন্ন করেছেন। আপনার শরীর আরও শক্তিশালী হয়ে উঠছে!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast heute alle deine Trainingseinheiten abgeschlossen. Dein Körper wird stärker, weiter so!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has completado todos tus entrenamientos de hoy. Tu cuerpo se fortalece, ¡sigue así!"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شما امروز تمام تمرینات خود را کامل کرده اید. بدن شما قوی‌تر می‌شود، همین‌طور ادامه دهید!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez terminé toutes vos séances du jour. Votre corps se renforce, continuez comme ça !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने आज के सभी वर्कआउट पूरे कर लिए। आपका शरीर मज़बूत हो रहा है, ऐसे ही जारी रखें!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda telah menyelesaikan semua latihan Anda hari ini. Tubuhmu semakin kuat, pertahankan!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日のワークアウトをすべて完了しました。体はどんどん強くなっています。この調子で続けましょう！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘의 운동을 모두 완료했어요. 몸이 점점 더 강해지고 있습니다. 계속 이어가세요!"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਅੱਜ ਆਪਣੀਆਂ ਸਾਰੀਆਂ ਕਸਰਤਾਂ ਪੂਰੀਆਂ ਕਰ ਲਈਆਂ ਹਨ। ਤੁਹਾਡਾ ਸਰੀਰ ਮਜ਼ਬੂਤ ​​ਹੋ ਰਿਹਾ ਹੈ ਇਸਨੂੰ ਜਾਰੀ ਰੱਖੋ!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você completou todos os seus treinos hoje. Seu corpo está ficando mais forte, continue assim!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы выполнили все тренировки на сегодня. Ваше тело становится сильнее — так держать!"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umekamilisha mazoezi yako yote leo. Mwili wako unakuwa na nguvu endelea!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您今天的训练已全部完成。您的身体正变得更强壮，继续保持！"
          }
        }
      }
    },
