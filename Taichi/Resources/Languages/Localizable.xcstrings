    "How does your body feel after exercise these days?" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيف يشعر جسمك بعد ممارسة الرياضة هذه الأيام؟"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই দিনগুলিতে ব্যায়ামের পরে আপনার শরীর কেমন অনুভব করে?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie fühlt sich Ihr Körper heutzutage nach dem Training an?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cómo se siente tu cuerpo después de hacer ejercicio últimamente?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این روزها بدن شما بعد از ورزش چه حسی دارد؟"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment se sent votre corps après l'exercice ces derniers temps ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन दिनों व्यायाम के बाद आपका शरीर कैसा महसूस करता है?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagaimana perasaan tubuh Anda setelah berolahraga hari ini?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近、運動後の体の調子はどうですか？"
