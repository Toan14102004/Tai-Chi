    "onboarding.testimonial.anna" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق رائع للتمرين في المنزل. لا حاجة إلى معدات لمعظم التمارين، مما يجعلها مريحة للغاية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বাড়িতে কাজ করার জন্য দুর্দান্ত অ্যাপ। বেশিরভাগ ওয়ার্কআউটের জন্য কোনও সরঞ্জামের প্রয়োজন নেই, যা এটিকে খুব সুবিধাজনক করে তোলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tolle App für das Training zu Hause. Für die meisten Trainingseinheiten ist keine Ausrüstung erforderlich, was es äußerst praktisch macht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Great app for working out at home. No equipment needed for most workouts, which makes it super convenient."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una app genial para entrenar en casa. No se necesita equipo para la mayoría de los entrenamientos, lo que la hace muy práctica."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه عالی برای تمرین در خانه. بدون نیاز به تجهیزات برای اکثر تمرینات، که آن را فوق العاده راحت می کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une excellente application pour s'entraîner à la maison. La plupart des exercices ne nécessitent aucun équipement, ce qui est très pratique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घर पर कसरत करने के लिए शानदार ऐप। अधिकांश वर्कआउट के लिए किसी उपकरण की जरूरत नहीं होती, इसलिए यह बहुत सुविधाजनक है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi bagus untuk berolahraga di rumah. Tidak diperlukan peralatan untuk sebagian besar latihan, sehingga sangat nyaman."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自宅での運動に最適なアプリです。ほとんどのワークアウトに器具が必要ないので、とても便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집에서 운동하기 좋은 앱이에요. 대부분의 운동에 장비가 필요 없어 정말 편리해요."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਘਰ ਵਿੱਚ ਕੰਮ ਕਰਨ ਲਈ ਵਧੀਆ ਐਪ. ਜ਼ਿਆਦਾਤਰ ਵਰਕਆਉਟ ਲਈ ਕਿਸੇ ਸਾਜ਼-ਸਾਮਾਨ ਦੀ ਲੋੜ ਨਹੀਂ ਹੈ, ਜੋ ਇਸਨੂੰ ਬਹੁਤ ਸੁਵਿਧਾਜਨਕ ਬਣਾਉਂਦਾ ਹੈ।"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ótimo aplicativo para malhar em casa. Nenhum equipamento é necessário para a maioria dos treinos, o que o torna muito conveniente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отличное приложение для тренировок дома. Для большинства упражнений оборудование не нужно, поэтому это очень удобно."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programu nzuri ya kufanya kazi nyumbani. Hakuna kifaa kinachohitajika kwa mazoezi mengi, ambayo hufanya iwe rahisi sana."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非常适合在家锻炼的应用。大多数训练不需要任何器材，非常方便。"
          }
        }
      }
    },
    "onboarding.testimonial.jennie" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مهدئ للغاية وسهل الاستخدام. أحب القيام بجلسة تاي تشي سريعة قبل أن أبدأ يومي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তাই শান্ত এবং ব্যবহার করা সহজ. আমি আমার দিন শুরু করার আগে একটি দ্রুত তাই চি সেশন করতে পছন্দ করি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So beruhigend und einfach anzuwenden. Ich liebe es, eine kurze Tai-Chi-Sitzung zu machen, bevor ich meinen Tag beginne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So calming and easy to use. I love doing a quick Tai Chi session before starting my day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muy relajante y fácil de usar. Me encanta hacer una sesión rápida de tai chi antes de empezar el día."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بنابراین آرام بخش و آسان برای استفاده. من عاشق انجام یک جلسه سریع تای چی قبل از شروع روزم هستم."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Très apaisant et facile à utiliser. J'aime faire une courte séance de tai-chi avant de commencer ma journée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुत शांत और उपयोग में आसान। दिन शुरू करने से पहले एक छोटा ताई ची सत्र करना मुझे पसंद है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sangat menenangkan dan mudah digunakan. Saya suka melakukan sesi Tai Chi singkat sebelum memulai hari saya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "とても落ち着けて使いやすいです。一日を始める前に短い太極拳セッションをするのが大好きです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정말 편안하고 사용하기 쉬워요. 하루를 시작하기 전에 짧게 태극권을 하는 것이 좋아요."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਲਈ ਸ਼ਾਂਤ ਅਤੇ ਵਰਤਣ ਲਈ ਆਸਾਨ. ਮੈਨੂੰ ਆਪਣਾ ਦਿਨ ਸ਼ੁਰੂ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਇੱਕ ਤੇਜ਼ ਤਾਈ ਚੀ ਸੈਸ਼ਨ ਕਰਨਾ ਪਸੰਦ ਹੈ।"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tão calmante e fácil de usar. Adoro fazer uma sessão rápida de Tai Chi antes de começar o dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очень успокаивает и удобно в использовании. Мне нравится выполнять короткую сессию тай-чи перед началом дня."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hivyo kutuliza na rahisi kutumia. Ninapenda kufanya kipindi cha haraka cha Tai Chi kabla ya kuanza siku yangu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非常放松，也很容易使用。我喜欢在开始新的一天之前做一次简短的太极练习。"
          }
        }
      }
    },
    "onboarding.testimonial.maria" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثالية للمبتدئين. التمارين سهلة الفهم وأشعر بالفعل بمرونة أكبر بعد بضعة أسابيع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নতুনদের জন্য পারফেক্ট। ব্যায়ামগুলি বোঝা সহজ এবং আমি ইতিমধ্যে কয়েক সপ্তাহ পরে আরও নমনীয় বোধ করছি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfekt für Anfänger. Die Übungen sind leicht verständlich und ich fühle mich bereits nach ein paar Wochen flexibler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfect for beginners. The exercises are easy to understand and I already feel more flexible after a few weeks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfecta para principiantes. Los ejercicios son fáciles de entender y ya me siento más flexible después de unas semanas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایده آل برای مبتدیان. درک تمرینات آسان است و من در حال حاضر بعد از چند هفته احساس انعطاف پذیری بیشتری می کنم."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parfait pour les débutants. Les exercices sont faciles à comprendre et je me sens déjà plus souple après quelques semaines."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुरुआती लोगों के लिए बेहतरीन। अभ्यास समझने में आसान हैं और कुछ हफ्तों में मुझे अधिक लचीलापन महसूस होने लगा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempurna untuk pemula. Latihannya mudah dimengerti dan saya sudah merasa lebih fleksibel setelah beberapa minggu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初心者にぴったりです。エクササイズはわかりやすく、数週間で体が柔らかくなったと感じています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초보자에게 딱 맞아요. 운동을 이해하기 쉽고 몇 주 만에 유연해진 것을 느꼈어요."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸ਼ੁਰੂਆਤ ਕਰਨ ਵਾਲਿਆਂ ਲਈ ਸੰਪੂਰਨ। ਅਭਿਆਸਾਂ ਨੂੰ ਸਮਝਣਾ ਆਸਾਨ ਹੈ ਅਤੇ ਮੈਂ ਕੁਝ ਹਫ਼ਤਿਆਂ ਬਾਅਦ ਪਹਿਲਾਂ ਹੀ ਵਧੇਰੇ ਲਚਕਦਾਰ ਮਹਿਸੂਸ ਕਰਦਾ ਹਾਂ।"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfeito para iniciantes. Os exercícios são fáceis de entender e já me sinto mais flexível depois de algumas semanas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отлично подходит для начинающих. Упражнения легко выполнять, и уже через несколько недель я почувствовала себя более гибкой."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamili kwa Kompyuta. Mazoezi ni rahisi kuelewa na tayari ninahisi kunyumbulika zaidi baada ya wiki chache."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非常适合初学者。动作简单易懂，几周后我已经感觉更柔韧了。"
          }
        }
      }
    },
