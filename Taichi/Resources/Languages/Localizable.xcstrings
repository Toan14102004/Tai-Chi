        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요즘 운동 후 몸 상태는 어떤가요?"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਅੱਜਕੱਲ੍ਹ ਕਸਰਤ ਕਰਨ ਤੋਂ ਬਾਅਦ ਤੁਹਾਡਾ ਸਰੀਰ ਕਿਵੇਂ ਮਹਿਸੂਸ ਕਰਦਾ ਹੈ?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como seu corpo se sente após o exercício hoje em dia?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как в последнее время чувствует себя ваше тело после упражнений?"
