        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜਾਰੀ ਰੱਖਣਾ ਚਾਹੁੰਦੇ ਹੋ, ਇੱਕ ਛੋਟਾ ਬ੍ਰੇਕ ਲੈਣਾ, ਜਾਂ ਬਾਅਦ ਵਿੱਚ ਜਾਰੀ ਰੱਖਣਾ ਚਾਹੁੰਦੇ ਹੋ?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quer continuar, fazer uma pequena pausa ou continuar mais tarde?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хотите продолжить, немного передохнуть или вернуться позже?"
