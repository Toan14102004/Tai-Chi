    "Find calm, balance, and strength every day." : {
      "comment" : "A description of the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابحث عن الهدوء والتوازن والقوة كل يوم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিদিন শান্ত, ভারসাম্য এবং শক্তি খুঁজুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finden Sie jeden Tag Ruhe, Ausgeglichenheit und Kraft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra calma, equilibrio y fuerza cada día."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر روز آرامش، تعادل و قدرت را پیدا کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouvez le calme, l'équilibre et la force chaque jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर दिन शांति, संतुलन और शक्ति पाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temukan ketenangan, keseimbangan, dan kekuatan setiap hari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日、静けさとバランス、そして力を見つけましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 평온함과 균형, 그리고 힘을 찾으세요."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹਰ ਰੋਜ਼ ਸ਼ਾਂਤ, ਸੰਤੁਲਨ ਅਤੇ ਤਾਕਤ ਲੱਭੋ।"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontre calma, equilíbrio e força todos os dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обретайте спокойствие, баланс и силу каждый день."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pata utulivu, usawa, na nguvu kila siku."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天寻找平静、平衡与力量。"
          }
        }
      }
    },
