    "We’re putting together a routine based on your goals, experience, and preferences." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نحن نقوم بتجميع روتين بناءً على أهدافك وخبرتك وتفضيلاتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমরা আপনার লক্ষ্য, অভিজ্ঞতা এবং পছন্দের উপর ভিত্তি করে একটি রুটিন তৈরি করছি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir stellen eine Routine zusammen, die auf Ihren Zielen, Erfahrungen und Vorlieben basiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estamos preparando una rutina basada en tus objetivos, experiencia y preferencias."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما بر اساس اهداف، تجربیات و ترجیحات شما، برنامه‌ای را تنظیم می‌کنیم."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous préparons une routine basée sur vos objectifs, votre expérience et vos préférences."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम आपके लक्ष्यों, अनुभव और पसंद के आधार पर एक रूटीन तैयार कर रहे हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami menyusun rutinitas berdasarkan tujuan, pengalaman, dan preferensi Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの目標、経験、好みに基づいてルーティンを作成しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목표와 경험, 취향에 맞춰 루틴을 구성하고 있어요."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਅਸੀਂ ਤੁਹਾਡੇ ਟੀਚਿਆਂ, ਅਨੁਭਵ ਅਤੇ ਤਰਜੀਹਾਂ ਦੇ ਆਧਾਰ 'ਤੇ ਇੱਕ ਰੁਟੀਨ ਤਿਆਰ ਕਰ ਰਹੇ ਹਾਂ।"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estamos montando uma rotina com base em seus objetivos, experiência e preferências."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы составляем программу на основе ваших целей, опыта и предпочтений."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunaweka pamoja utaratibu kulingana na malengo, uzoefu na mapendeleo yako."
