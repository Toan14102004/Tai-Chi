    "Every check-in moves your forward. Keep coming back and let your streak grow." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل تسجيل وصول يدفعك للأمام. استمر في العودة ودع خطك ينمو."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি চেক-ইন আপনার এগিয়ে নিয়ে যায়। ফিরে আসতে থাকুন এবং আপনার স্ট্রীক বাড়তে দিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Check-in bringt Sie voran. Kommen Sie immer wieder zurück und lassen Sie Ihren Streak wachsen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada sesión te hace avanzar. Vuelve cada día y haz crecer tu racha."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر ورود شما را به جلو می برد. به بازگشت ادامه دهید و اجازه دهید خط شما رشد کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque séance vous fait avancer. Revenez régulièrement pour faire grandir votre série."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर चेक-इन आपको आगे बढ़ाता है। लौटते रहें और अपनी स्ट्रीक बढ़ाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap check-in memajukan Anda. Teruslah kembali dan biarkan pukulan Anda berkembang."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックインするたびに前進します。続けて記録を伸ばしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체크인할 때마다 한 걸음씩 나아갑니다. 꾸준히 돌아와 연속 기록을 늘려보세요."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹਰ ਚੈੱਕ-ਇਨ ਤੁਹਾਨੂੰ ਅੱਗੇ ਵਧਾਉਂਦਾ ਹੈ। ਵਾਪਸ ਆਉਂਦੇ ਰਹੋ ਅਤੇ ਆਪਣੀ ਲੜੀ ਨੂੰ ਵਧਣ ਦਿਓ।"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada check-in faz você avançar. Continue voltando e deixe sua sequência crescer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждое занятие продвигает вас вперёд. Возвращайтесь и наращивайте свою серию."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kila kuingia hukusogeza mbele. Endelea kurudi na kuruhusu mfululizo wako kukua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一次打卡都是进步。坚持回来，让连续记录持续增长。"
          }
        }
      }
    },
